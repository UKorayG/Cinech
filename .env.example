# Cinech ortam değişkenleri — bu dosyayı .env.local olarak kopyala ve doldur.
# Gizli anahtarlar (özel anahtar vb.) asla depoya eklenmez; .env* zaten .gitignore içinde.

# Sitenin tam adresi (alan adı alınınca); sosyal paylaşım görselleri için. Boşsa Vercel adresi kullanılır.
NEXT_PUBLIC_SITE_URL=

# WalletConnect Cloud proje kimliği (RainbowKit için)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canlı oda sunucusu (npm run socket ile başlar; boş bırakılırsa odalar yerel modda çalışır)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3101
# SOCKET_PORT=3101
# SOCKET_CORS_ORIGINS=http://localhost:3100,http://localhost:3000

# Sepolia'ya dağıtılan MovieVotingDAO adresi (sözleşme dağıtımı yapılınca doldurulacak)
NEXT_PUBLIC_DAO_CONTRACT_ADDRESS=

# --- Yalnızca sözleşme dağıtımı için (tarayıcıya gitmez) ---
# Dağıtım cüzdanının özel anahtarı. ASLA depoya ekleme; bu dosya .gitignore ile korunur.
PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# npx hardhat verify için (isteğe bağlı)
ETHERSCAN_API_KEY=
